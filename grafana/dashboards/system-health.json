    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "SYN Flood attack mitigation via syncookies.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "green",
